# --- Database ---
# Local (default): a SQLite file. On Vercel use a Turso/libSQL URL + auth token.
DATABASE_URL="file:./data/seo.db"
# DATABASE_AUTH_TOKEN=""            # only for remote libsql:// URLs (Turso)

# --- Google OAuth (Blogger, Search Console, Analytics, AdSense) ---
# Create an OAuth Client (type: Web application) in Google Cloud Console,
# add http://localhost:8123/callback to Authorized redirect URIs.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: skip the browser flow entirely (e.g. inside Claude Code remote)
# by pasting a refresh token obtained on any machine with `seo auth login`.
GOOGLE_REFRESH_TOKEN=""

# --- Optional integrations ---
GEMINI_API_KEY=""                   # AI assist in the web app / --ai gemini
SERPER_API_KEY=""                   # live SERP + People Also Ask (2,500 free credits)
PAGESPEED_API_KEY=""                # PageSpeed Insights (free, raises quota)
BING_WEBMASTER_API_KEY=""           # Bing query stats + URL submission
